.env
.env.local
.DS_Store

# Mix working data — tracklists are personal
/mixes/

# Lesson notes — personal
/lessons/

# Performable sets — personal
/sets/

# Reader app local artifacts
reader/node_modules/
reader/.next/
reader/.turbo/
reader/tsconfig.tsbuildinfo

# Local Claude Code state
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Rekordbox library exports — personal
/rekordbox-export.xml
/rekordbox-export*.xml

# Skill-local venvs (e.g. pyrekordbox for the cued-tracks extractor)
.claude/skills/*/.venv/

# Python bytecode caches (anywhere in the tree)
**/__pycache__/
*.pyc

# Local browser-automation profiles — everything goes under .playwright/ (at any depth)
**/.playwright/
.playwright/
